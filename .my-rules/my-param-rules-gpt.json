{
    "operations": [
        {
            "mode": "delete",
            "description": "gpt-6只支持默认temperature(1)，删除非1的temperature避免400",
            "path": "temperature",
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "gpt-6"
                },
                {
                    "path": "temperature",
                    "mode": "full",
                    "value": 1,
                    "invert": true
                }
            ],
            "logic": "AND"
        },
        {
            "mode": "set",
            "description": "gpt-6的max_output_tokens低于最小值16时抬到16避免400",
            "path": "max_output_tokens",
            "value": 16,
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "gpt-6"
                },
                {
                    "path": "max_output_tokens",
                    "mode": "lt",
                    "value": 16
                }
            ],
            "logic": "AND"
        },
        {
            "mode": "set",
            "description": "gpt-6在chat/completions下function tools与reasoning_effort冲突，置为none避免400",
            "path": "reasoning_effort",
            "value": "none",
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "gpt-6"
                },
                {
                    "path": "tools.#(type==\"function\").type",
                    "mode": "full",
                    "value": "function"
                },
                {
                    "path": "reasoning_effort",
                    "mode": "full",
                    "value": "none",
                    "invert": true
                }
            ],
            "logic": "AND"
        },
        {
            "mode": "move",
            "description": "chat completions的max_tokens已经弃用",
            "from": "max_tokens",
            "to": "max_completion_tokens",
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "gpt-6"
                }
            ],
            "logic": "OR"
        }
    ]
}