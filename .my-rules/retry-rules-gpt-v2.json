[
  {
    "description": "gpt流式响应200但message包含stream failed或rate limit时改写为429返回",
    "phase1_request_condition": {
      "conditions": [
        {
          "path": "model",
          "mode": "prefix",
          "value": "gpt-"
        },
        {
          "path": "relay_format",
          "mode": "full",
          "value": "openai_responses"
        }
      ],
      "logic": "AND"
    },
    "phase2_response_conditions": {
      "conditions": [
        {
          "path": "status_code",
          "mode": "full",
          "value": 200
        },
        {
          "path": "response_body",
          "mode": "regex",
          "value": "stream failed|rate limit|exceeds the maximum usage size|service temporarily unavailable"
        }
      ],
      "logic": "AND"
    },
    "phase4_retry_action": {
      "action": "return_error",
      "status_code": 429
    }
  },
  {
    "description": "解决gpt模型兜底到下一个渠道时无法解密的问题-case1（有function_call时才删id）",
    "phase1_request_condition": {
      "conditions": [
        {
          "path": "model",
          "mode": "prefix",
          "value": "gpt-"
        },
        {
          "path": "relay_format",
          "mode": "full",
          "value": "openai_responses"
        }
      ],
      "logic": "AND"
    },
    "phase2_response_conditions": {
      "conditions": [
        {
          "path": "status_code",
          "mode": "full",
          "value": 400
        },
        {
          "path": "error_message",
          "mode": "contains",
          "value": "encrypted content"
        }
      ],
      "logic": "AND"
    },
    "phase3_request_rewrite": [
      {
        "mode": "prune_objects",
        "path": "input",
        "value": {
          "where": {
            "type": "reasoning"
          }
        }
      },
      {
        "mode": "delete",
        "path": "input.*.id",
        "conditions": [
          {
            "path": "input.#(type==\"function_call\").type",
            "mode": "full",
            "value": "function_call"
          }
        ],
        "logic": "AND"
      }
    ],
    "phase4_retry_action": "retry_same_channel"
  },
