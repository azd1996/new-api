{
    "operations": [
        {
            "mode": "regex_replace",
            "description": "system为数组且首段text存在时才trim",
            "path": "system.0.text",
            "from": "^\\s+|\\s+$",
            "to": "",
            "conditions": [
                {
                    "path": "system.0.text",
                    "mode": "prefix",
                    "value": ""
                }
            ],
            "logic": "OR"
        },
        {
            "description": "system为数组且首段为空时则删除system",
            "mode": "delete",
            "path": "system",
            "conditions": [
                {
                    "path": "system.0.text",
                    "mode": "full",
                    "value": ""
                }
            ],
            "logic": "OR"
        },
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "output_config",
            "value": {
                "effort": "medium"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-sonnet-5"
                }
            ],
            "logic": "AND"
        },
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "thinking",
            "value": {
                "type": "adaptive"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-sonnet-5"
                }
            ],
            "logic": "AND"
        },        
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "output_config",
            "value": {
                "effort": "medium"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ],
            "logic": "AND"
        },
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "thinking",
            "value": {
                "type": "adaptive"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ],
            "logic": "AND"
        },
        {
            "description": "claude-opus-5-5: thinking存在且type不存在或!=adaptive时补output_config.effort",
            "mode": "set",
            "path": "output_config.effort",
            "value": "medium",
            "keep_origin": true,
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-opus-5-5" },
                { "path": "thinking", "mode": "contains", "value": "" },
                { "path": "thinking.type", "mode": "full", "value": "adaptive", "invert": true, "pass_missing_key": true }
            ],
            "logic": "AND"
        },
        {
            "description": "claude-opus-5-5: thinking存在且type不存在或!=adaptive时统一转adaptive",
            "mode": "set",
            "path": "thinking",
            "value": {
                "type": "adaptive"
            },
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-opus-5-5" },
                { "path": "thinking", "mode": "contains", "value": "" },
                { "path": "thinking.type", "mode": "full", "value": "adaptive", "invert": true, "pass_missing_key": true }
            ],
            "logic": "AND"
        },
        {
            "description": "format字段不再被支持",
            "path": "output_config.format",
            "mode": "delete",
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ]
        },
        {
            "description": "claude-opus-5: thinking.display仅非法值(非summarized/omitted)兜底改为summarized，合法值保留，避免Bedrock 400",
            "mode": "set",
            "path": "thinking.display",
            "value": "summarized",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-" },
                { "path": "thinking.display", "mode": "full", "value": "summarized", "invert": true },
                { "path": "thinking.display", "mode": "full", "value": "omitted", "invert": true }
            ],
            "logic": "AND"
        },
        {
            "description": "claude-: 存在context_management时给anthropic-beta追加context-management-2025-06-27，启用Bedrock服务端上下文管理",
            "mode": "set_header",
            "path": "anthropic-beta",
            "value": { "$append": ["context-management-2025-06-27"] },
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-" },
                { "path": "context_management", "mode": "contains", "value": "" }
            ],
            "logic": "AND"
        },
        {
            "description": "删除messages里的system角色",
            "mode": "prune_objects",
            "path": "messages",
            "value": {
                "where": {
                    "role": "system"
                },
                "recursive": false
            }
        },
        {
            "description": "claude-: 删除空的text内容块(type==text且text为空)，避免Bedrock 400 text content blocks must be non-empty；只扫content数组且不递归，避免误入tool_use.input触发类型比较崩溃",
            "mode": "prune_objects",
            "path": "messages.*.content",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-" }
            ],
            "value": {
                "logic": "AND",
                "recursive": false,
                "conditions": [
                    { "path": "type", "mode": "full", "value": "text" },
                    { "path": "text", "mode": "full", "value": "" }
                ]
            }
        },
        {
            "description": "claude-: messages.0 content为空数组([])时补占位，避免Bedrock 400 non-empty content。用content.#==0做类型安全判空，content为非空数组或字符串时都不会触发类型比较崩溃",
            "mode": "set",
            "path": "messages.0.content",
            "value": ".",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "claude-" },
                { "path": "messages.0.content.#", "mode": "full", "value": 0 }
            ],
            "logic": "AND"
        },
        {
            "description": "claude 5系列(opus-5/sonnet-5)已弃用temperature，存在即删除，避免400 temperature is deprecated for this model",
            "mode": "delete",
            "path": "temperature",
            "conditions": [
                { "path": "model", "mode": "contains", "value": "claude-opus-5" },
                { "path": "model", "mode": "contains", "value": "claude-sonnet-5" }
            ],
            "logic": "OR"
        },
        {
            "description": "gpt-6只支持默认temperature(1)，删除非1的temperature避免400",
            "mode": "delete",
            "path": "temperature",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "temperature", "mode": "full", "value": 1, "invert": true }
            ],
            "logic": "AND"
        },
        {
            "description": "gpt-6的max_output_tokens低于最小值16时抬到16避免400",
            "mode": "set",
            "path": "max_output_tokens",
            "value": 16,
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "max_output_tokens", "mode": "lt", "value": 16 }
            ],
            "logic": "AND"
        },
        {
            "description": "gpt-6在chat/completions下function tools与reasoning_effort冲突，置为none避免400",
            "mode": "set",
            "path": "reasoning_effort",
            "value": "none",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "tools.#(type==\"function\").type", "mode": "full", "value": "function" },
                { "path": "reasoning_effort", "mode": "full", "value": "none", "invert": true }
            ],
            "logic": "AND"
        }
    ]
}