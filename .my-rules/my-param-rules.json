{
    "operations": [
        {
            "mode": "regex_replace",
            "description": "system为数组且首段text存在时才trim",
            "path": "system.0.text",
            "from": "^\\s+|\\s+$",
            "to": "",
            "conditions": [
                {
                    "path": "system.0.text",
                    "mode": "prefix",
                    "value": ""
                }
            ],
            "logic": "OR"
        },
        {
            "description": "system为数组且首段为空时则删除system",
            "mode": "delete",
            "path": "system",
            "conditions": [
                {
                    "path": "system.0.text",
                    "mode": "full",
                    "value": ""
                }
            ],
            "logic": "OR"
        },
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "output_config",
            "value": {
                "effort": "medium"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ],
            "logic": "AND"
        },
        {
            "description": "thinking的enabled to adaptive参数适配",
            "mode": "set",
            "path": "thinking",
            "value": {
                "type": "adaptive"
            },
            "conditions": [
                {
                    "path": "thinking.type",
                    "mode": "full",
                    "value": "enabled"
                },
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ],
            "logic": "AND"
        },
        {
            "description": "format字段不再被支持",
            "path": "output_config.format",
            "mode": "delete",
            "conditions": [
                {
                    "path": "model",
                    "mode": "prefix",
                    "value": "claude-opus-5"
                }
            ]
        },
        {
            "description": "删除messages里的system角色",
            "mode": "prune_objects",
            "path": "messages",
            "value": {
                "where": {
                    "role": "system"
                },
                "recursive": false
            }
        },
        {
            "description": "gpt-6只支持默认temperature(1)，删除非1的temperature避免400",
            "mode": "delete",
            "path": "temperature",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "temperature", "mode": "full", "value": 1, "invert": true }
            ],
            "logic": "AND"
        },
        {
            "description": "gpt-6的max_output_tokens低于最小值16时抬到16避免400",
            "mode": "set",
            "path": "max_output_tokens",
            "value": 16,
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "max_output_tokens", "mode": "lt", "value": 16 }
            ],
            "logic": "AND"
        },
        {
            "description": "gpt-6在chat/completions下function tools与reasoning_effort冲突，置为none避免400",
            "mode": "set",
            "path": "reasoning_effort",
            "value": "none",
            "conditions": [
                { "path": "model", "mode": "prefix", "value": "gpt-6" },
                { "path": "tools.#(type==\"function\").type", "mode": "full", "value": "function" },
                { "path": "reasoning_effort", "mode": "full", "value": "none", "invert": true }
            ],
            "logic": "AND"
        }
    ]
}